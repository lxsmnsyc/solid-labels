{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "if git cat-file -e \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}^{commit}\" 2>/dev/null; then git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- :/website :/packages :/package.json :/pnpm-lock.yaml :/pnpm-workspace.yaml; else exit 1; fi",
  "buildCommand": "pnpm --filter \"website^...\" build && pnpm build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/repl",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/getting-started",
      "destination": "/docs/getting-started",
      "permanent": true
    },
    {
      "source": "/ctf",
      "destination": "/docs/ctf",
      "permanent": true
    },
    {
      "source": "/namespace",
      "destination": "/docs/namespace",
      "permanent": true
    },
    {
      "source": "/migration",
      "destination": "/docs/migration",
      "permanent": true
    }
  ]
}
