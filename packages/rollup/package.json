{
  "name": "rollup-plugin-solid-labels",
  "version": "0.17.0",
  "private": false,
  "description": "Simple, reactive labels for SolidJS",
  "keywords": [
    "solid-js",
    "solid-labels",
    "rollup",
    "babel",
    "labels",
    "reactivity"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-labels/tree/main/packages/rollup",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-labels/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "url": "https://github.com/lxsmnsyc/solid-labels.git",
    "type": "git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "unplugin-solid-labels": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "rollup": "^4.64.6",
    "solid-labels": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "rollup": "^3 || ^4",
    "solid-labels": "^0.17"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
