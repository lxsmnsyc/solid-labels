{
  "name": "solid-labels",
  "version": "0.17.0",
  "private": false,
  "description": "Simple, reactive labels for SolidJS",
  "keywords": [
    "babel",
    "labels",
    "reactivity",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-labels/tree/main/packages/core",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-labels/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-labels.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./babel": {
      "import": "./dist/babel.js",
      "require": "./dist/babel.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.5",
    "solid-js": "^1.9.17",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@babel/core": "^7.25",
    "solid-js": "^1.3"
  },
  "engines": {
    "node": ">=18"
  }
}
