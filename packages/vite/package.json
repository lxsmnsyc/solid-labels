{
  "name": "vite-plugin-solid-labels",
  "version": "0.17.0",
  "private": false,
  "description": "Simple, reactive labels for SolidJS",
  "keywords": [
    "babel",
    "labels",
    "pridepack",
    "reactivity",
    "solid-js"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-labels/tree/main/packages/vite",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-labels/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-labels.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/cjs/production/index.cjs",
  "module": "./dist/esm/production/index.mjs",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {}
  },
  "exports": {
    ".": {
      "development": {
        "require": "./dist/cjs/development/index.cjs",
        "import": "./dist/esm/development/index.mjs"
      },
      "require": "./dist/cjs/production/index.cjs",
      "import": "./dist/esm/production/index.mjs",
      "types": "./dist/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublish": "pridepack clean && pridepack build",
    "build": "pridepack build",
    "type-check": "pridepack check",
    "lint": "pridepack lint",
    "clean": "pridepack clean",
    "watch": "pridepack watch"
  },
  "dependencies": {
    "unplugin-solid-labels": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "pridepack": "2.6.0",
    "rollup": "^4.34.8",
    "solid-labels": "0.17.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^6.1.1"
  },
  "peerDependencies": {
    "solid-labels": "^0.17",
    "vite": "^3 || ^4 || ^5 || ^6 || ^7 || ^8"
  },
  "engines": {
    "node": ">=10"
  }
}
