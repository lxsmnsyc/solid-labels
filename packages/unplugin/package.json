{
  "name": "unplugin-solid-labels",
  "version": "0.17.0",
  "private": false,
  "description": "Unplugin for solid-labels",
  "keywords": [
    "solid-js",
    "solid-labels",
    "unplugin",
    "vite",
    "rollup"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-labels/tree/main/packages/unplugin",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-labels/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-labels.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@rollup/pluginutils": "^5.4.0",
    "unplugin": "^2.3.11"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "rollup": "^4.64.6",
    "solid-labels": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "rollup": "^3 || ^4",
    "solid-labels": "^0.17",
    "vite": "^3 || ^4 || ^5 || ^6 || ^7 || ^8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "rollup": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
